{
  "name": "backend",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.js",
    "build": "if ! command -v cargo; then curl https://sh.rustup.rs -sSf | sh -s -- -y; fi && export PATH=\"$HOME/.cargo/bin:$PATH\" && cd native_core && cargo build --release",
    "postinstall": "bun run build",
    "start": "bun index.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
